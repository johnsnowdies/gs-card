{
    "folders": [
        {
            "path": "."
        }
    ],
    "build_systems": [
        {
            "name": "My Make (fix+clean+build)",
            "shell_cmd": "make fix && make clean && make build LANG=ru",
            "working_dir": "${project_path:${folder}}",
            "file_regex": "^(..[^:]*):([0-9]+):?([0-9]+)?:? (.*)$"
        }
    ],
    "settings": {
        "tab_size": 2,
        "translate_tabs_to_spaces": true,
        "detect_indentation": false
    },
    "linters": {
        "cppcheck": {
            "std": [
                "c89"
            ]
        }
    }
}
